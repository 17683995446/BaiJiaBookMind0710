# 拆书 Agent 环境变量配置
# 复制此文件为 .env 并修改对应值

# ── LLM 配置 ──
BD_API_KEY=sk-your-api-key-here
BD_BASE_URL=https://api.siliconflow.cn/v1
BD_MODEL=Qwen/Qwen3.5-9B

# ── 服务配置 ──
BD_UPLOAD_DIR=/tmp/book_digest_uploads
BD_PRESET_DIR=/workspace/test_books
BD_MAX_UPLOAD_SIZE=52428800
BD_JOB_TIMEOUT=1800
BD_CORS_ORIGINS=*

# ── 缓存与输出 ──
BD_CACHE_DIR=.book_digest_cache
BD_OUTPUT_DIR=output
